<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 target gives access to the built-in voices (Frank for Dutch) and location -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- For UI Automation (reading buttons and fields in other apps) -->
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Dave</AssemblyName>
    <!-- Raise this for every new installer you share, so Windows shows it as an update -->
    <Version>1.5.0</Version>
    <RootNamespace>DaveWindows</RootNamespace>
    <ApplicationIcon>Dave.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- For scaling up the screen glow fast (direct pixel access) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microphone, playback and Windows volume -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- Offline speech recognition for the "Hé Dave" wake word -->
    <PackageReference Include="Vosk" Version="0.3.38" />
    <!-- Windows Search index, for finding files fast -->
    <PackageReference Include="System.Data.OleDb" Version="8.0.1" />
    <!-- Dave's window (Ctrl+Alt+W): drawn with Edge's engine, which is built into Windows 10/11 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <!-- The page shown in Dave's window -->
    <EmbeddedResource Include="DaveWindow.html" LogicalName="DaveWindow.html" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same small English model the car version uses for "Hé Dave" -->
    <Content Include="model-en-us\**" CopyToOutputDirectory="PreserveNewest" LinkBase="model-en-us" />
  </ItemGroup>

</Project>
