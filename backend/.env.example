# Copy this file to .env and fill it in.

# Which AI to use: "groq" (free, fastest) or "claude" (paid, smartest)
AI_PROVIDER=groq

# Groq: free key from https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Claude (only needed if AI_PROVIDER=claude): https://console.anthropic.com -> API Keys
# ANTHROPIC_API_KEY=sk-ant-...

# Any long random password. The car app sends it so nobody else can use your API key.
APP_TOKEN=change-me-to-something-long-and-random

# Where you drive, so answers use the right units, currency and local info
DRIVER_LOCATION=the Netherlands

PORT=3000
